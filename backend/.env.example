# Example environment configuration for Anime Viewer Plus backend
# Copy this file to .env and adjust as needed.

# Service host and port
HOST=0.0.0.0
PORT=3001

# Optional: override base URL for the free anime API (Consumet Gogoanime)
# Defaults to https://api.consumet.org/anime/gogoanime if not set.
ANIME_API_BASE=https://api.consumet.org/anime/gogoanime

# Node environment: development | production
NODE_ENV=development
